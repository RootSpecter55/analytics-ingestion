# --- Runtime ---
APP_ENV=development
PORT=8000
LOG_LEVEL=INFO

# --- Secrets loading (scripts/start_with_secrets.py) ---
# local: use this .env file. aws: fetch one JSON secret from AWS Secrets Manager.
SECRETS_SOURCE=local
SECRET_ID=
AWS_REGION=

# --- Database and Redis ---
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5450/analytics
REDIS_URL=redis://localhost:6384/0

# --- Auth: the admin key creates projects and registers schemas ---
ADMIN_API_KEY=change-me-admin-key-at-least-32-characters

# --- Event storage (StorageProvider): local | s3 ---
STORAGE_PROVIDER=local
LOCAL_DATA_DIR=./data/lake
S3_BUCKET=

# --- Queries (QueryEngine): duckdb (needs local storage) | athena ---
QUERY_ENGINE=duckdb
ATHENA_DATABASE=
ATHENA_TABLE=events
ATHENA_WORKGROUP=primary
ATHENA_OUTPUT_LOCATION=

# --- Ingestion ---
MAX_BATCH_SIZE=500
# How long an event id is remembered for deduplication.
DEDUP_TTL_SECONDS=86400
# Events may be at most this far in the future (clock skew) and this old.
MAX_FUTURE_SECONDS=300
MAX_EVENT_AGE_DAYS=365
EVENTS_STREAM=events

# --- Flusher: writes a Parquet file per partition when either limit is reached ---
FLUSH_MAX_EVENTS=5000
FLUSH_MAX_SECONDS=60
# Fixed consumer name, so a restarted flusher picks up its own unacknowledged events.
FLUSHER_NAME=flusher-1
